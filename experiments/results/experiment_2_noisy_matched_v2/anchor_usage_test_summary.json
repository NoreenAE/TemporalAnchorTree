{
  "schema_version": 2,
  "definitions": {
    "scope": "Creation/window rows include every dynamic-anchor feature. Filter anchor_feature=FishIntroduction for fish-only rows.",
    "legacy_cohort_fields": "created_not_used, documented_no_anchor and no_anchor_created remain FishIntroduction-specific.",
    "dynamic_anchor_used": "An actual downstream visit has an available dynamic-anchor window, even if it contains no events.",
    "created": "At least one nonempty FishIntroduction-derived anchor timestamp.",
    "used": "A visited downstream split references a fish-derived anchor and has a nonempty evaluated_windows list; no event need occur in it.",
    "symptom_used": "Used as above, restricted to GI or Vomiting.",
    "visit_rows": "Only actual held-out prediction visits; one row per evaluated window, or one blank-window row if unavailable."
  },
  "observations_file": "observations.csv",
  "patient_metadata_file": "patients_and_split.csv",
  "join_key": "patient_id",
  "runs": {
    "dynamic_on": {
